{
  "name": "@beforewave/agent-helm-ui-contract",
  "version": "0.1.3",
  "description": "Browser-safe shared Agent Helm UI locale and presentation contract.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeforeWave/agent-helm.git",
    "directory": "packages/agent-helm-ui-contract"
  },
  "homepage": "https://github.com/BeforeWave/agent-helm#readme",
  "bugs": {
    "url": "https://github.com/BeforeWave/agent-helm/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=neutral --format=esm --target=es2022 --minify --outfile=lib/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('lib',{recursive:true,force:true})\"",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "agentHelm": {
    "ownership": "shared"
  }
}
